{
  "openapi": "3.0.3",
  "info": {
    "title": "API Mender Managed Quote API",
    "version": "2.0.0",
    "description": "Pilot v2: required request identity renamed from customerId to accountId for the live API Mender repair check."
  },
  "paths": {
    "/api/managed/quotes": {
      "post": {
        "operationId": "createManagedQuote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "accountId",
                  "sku"
                ],
                "properties": {
                  "accountId": {
                    "type": "string"
                  },
                  "sku": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "sku",
                    "amountCents",
                    "contractVersion"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "sku": {
                      "type": "string"
                    },
                    "amountCents": {
                      "type": "integer"
                    },
                    "contractVersion": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          },
          "422": {
            "description": "Request does not match the published contract"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://apimender.com"
    }
  ]
}
